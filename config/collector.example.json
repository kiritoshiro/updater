{
  "server_id": "primary-server",
  "origin_ip": "203.0.113.10",
  "ca_file": "/etc/site-watch/cloudflare-origin-ca.pem",
  "ignore_failed_units": ["user@*.service"],
  "github_token_file": "/etc/site-watch/github-token",
  "github": {
    "theme:example-theme": "your-account/your-theme"
  },
  "sites": [
    {
      "id": "example.org",
      "kind": "wordpress",
      "owner": "example",
      "path": "/home/example/public_html",
      "health_paths": ["/", "/wp-login.php", "/category/news/"],
      "github": {
        "plugin:example-plugin": "your-account/your-plugin",
        "plugin:upstream-build": null
      }
    },
    {
      "id": "app.example.org",
      "kind": "web",
      "ca_file": null,
      "health_paths": ["/"]
    },
    {
      "id": "laravel.example.org",
      "kind": "web",
      "owner": "laravelapp",
      "path": "/home/laravelapp/app",
      "health_paths": ["/", "/login"],
      "app": {
        "type": "laravel",
        "repository": "your-account/your-app",
        "branch": "main",
        "database": {"format": "env", "file": ".env", "name": "laravelapp"}
      }
    }
  ]
}
